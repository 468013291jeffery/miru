  "endings": {
    "A": {
      "id": "lucien",
      "t": {
        "zh": "重新相识",
        "en": "Begin Again"
      },
      "txt": {
        "zh": "旧肖像留在档案馆。Lucien将第一次约会的时间留白，等双方共同确定。\n你们保留各自生活，约定每次亲近都听现在的意愿。\n下一次相见可以只是喝咖啡，不必拯救整座城市。",
        "en": "The old portraits remain in the archive. Lucien leaves the first date’s time open for both of you to agree.\nYou retain separate lives and agree to hear present wishes before every new intimacy.\nThe next meeting can simply be coffee. It need not save an entire city."
      },
      "line": {
        "zh": "明天仍可以继续相见，也可以自由改变。",
        "en": "Tomorrow still allows another meeting, and the freedom to change."
      }
    },
    "B": {
      "id": "rowan",
      "t": {
        "zh": "共同生活",
        "en": "A Shared Life"
      },
      "txt": {
        "zh": "医院恢复夜间急诊。Rowan把一次海边出游留在双方可调整的日程里。\n恋爱不替代工作边界，也不要求你负责他的每一次值班。\n下一轮复诊与一次日出之约，都是生活的一部分。",
        "en": "The hospital’s night clinic reopens. Rowan leaves a coastal trip on a schedule both of you can change.\nRomance does not replace work boundaries or make you responsible for every shift.\nThe next follow-up and a sunrise together can both belong to ordinary life."
      },
      "line": {
        "zh": "明天仍可以继续相见，也可以自由改变。",
        "en": "Tomorrow still allows another meeting, and the freedom to change."
      }
    },
    "C": {
      "id": "cassian",
      "t": {
        "zh": "重建信任",
        "en": "Trust Rebuilt"
      },
      "txt": {
        "zh": "猎人团撤销旧血誓，Cassian把责任审查交给独立成员。\n你们的关系不替他免除责任；信任可以慢慢重新建立。\n第一次没有任务的散步，路线由两人共同商量。",
        "en": "The hunters revoke the old blood oath. Cassian submits accountability review to independent members.\nYour relationship does not exempt him from responsibility. Trust can be rebuilt slowly.\nThe first walk without a mission has a route the two of you can choose together."
      },
      "line": {
        "zh": "明天仍可以继续相见，也可以自由改变。",
        "en": "Tomorrow still allows another meeting, and the freedom to change."
      }
    },
    "D": {
      "id": "independent",
      "t": {
        "zh": "独立的明天",
        "en": "An Independent Tomorrow"
      },
      "txt": {
        "zh": "联系册保留朋友与公共求助渠道，不登记恋人。\n没有期限的车票可以买，也可以留待以后。城市不再收取自由的代价。\n朋友的下一封来信，会先问你愿不愿意收到。",
        "en": "The register retains friends and public support contacts without naming a romantic partner.\nAn open-ended ticket can be bought now or later. The city no longer charges for freedom.\nThe next letter from a friend will first ask whether you wish to receive it."
      },
      "line": {
        "zh": "明天仍可以继续相见，也可以自由改变。",
        "en": "Tomorrow still allows another meeting, and the freedom to change."
      }
    },
    "E": {
      "id": "open",
      "t": {
        "zh": "开放的未来",
        "en": "An Open Future"
      },
      "txt": {
        "zh": "城市修复计划以伙伴身份存档，关系没有被偷偷补全。\n未来可以出现约会，也可以一直只有友谊；没人为等待记账。\n下一次见面先谈一顿饭，新的日子不需要命运批准。",
        "en": "The restoration plan records companionship without silently inventing a relationship.\nThere may be dates later, or lasting friendship. No one keeps a debt for waiting.\nThe next meeting can start with a meal. New days need no permission from fate."
      },
      "line": {
        "zh": "明天仍可以继续相见，也可以自由改变。",
        "en": "Tomorrow still allows another meeting, and the freedom to change."
      }
    }
  },
