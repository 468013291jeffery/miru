    {
      "scene_id": "M110-C11-S01",
      "chapter": 11,
      "scene": 1,
      "title": "董事会方案",
      "asset_id": "M110-BG-041",
      "narration_zh": "治理机制调整，Adrian有条件恢复CEO工作。",
      "dialogue_en": [
        {
          "speaker_as_written": "Adrian",
          "text": "I need some time to decide what I want."
        }
      ],
      "source_line": 290,
      "source_status": "specification",
      "image_status": "TO_PRODUCE"
    },
    {
      "scene_id": "M110-C11-S02",
      "chapter": 11,
      "scene": 2,
      "title": "厨房崩溃",
      "asset_id": "M110-BG-042",
      "narration_zh": "家中他承认身心疲惫以及对事业的矛盾感。",
      "dialogue_en": [
        {
          "speaker_as_written": "Adrian",
          "text": "I don’t know what I want anymore."
        }
      ],
      "source_line": 294,
      "source_status": "specification",
      "image_status": "TO_PRODUCE"
    },
    {
      "scene_id": "M110-C11-S03",
      "chapter": 11,
      "scene": 3,
      "title": "爱与财富的选择",
      "asset_id": "M110-BG-043",
      "narration_zh": "他问是否离开财富也会被爱。",
      "dialogue_en": [
        {
          "speaker_as_written": "Adrian",
          "text": "Would you still want me if I wasn’t a billionaire?"
        }
      ],
      "source_line": 298,
      "source_status": "specification",
      "image_status": "TO_PRODUCE"
    },
    {
      "scene_id": "M110-C11-S04",
      "chapter": 11,
      "scene": 4,
      "title": "共同决定未来",
      "asset_id": "M110-BG-044",
      "narration_zh": "二人决定继续CEO、正式交接或暂休。",
      "dialogue_en": [
        {
          "speaker_as_written": "Adrian",
          "text": "I still love cooking for you. I just don’t need to earn love with it."
        }
      ],
      "source_line": 303,
      "source_status": "specification",
      "image_status": "TO_PRODUCE"
    },
    {
      "scene_id": "M110-C12-S01",
      "chapter": 12,
      "scene": 1,
      "title": "回到玄关",
      "asset_id": "M110-BG-045",
      "narration_zh": "同一时间、同一玄关再度迎接，回扣序章。",
      "dialogue_en": [
        {
          "speaker_as_written": "Adrian",
          "text": "Welcome home, sweetheart."
        }
      ],
      "source_line": 311,
      "source_status": "specification",
      "image_status": "TO_PRODUCE"
    },
    {
      "scene_id": "M110-C12-S02",
      "chapter": 12,
      "scene": 2,
      "title": "最后一封信",
      "asset_id": "M110-BG-046",
      "narration_zh": "他读出最后一封信，表达独立且自愿的爱。",
      "dialogue_en": [
        {
          "speaker_as_written": "Adrian",
          "text": "I can love following your lead and still be myself."
        }
      ],
      "source_line": 315,
      "source_status": "specification",
      "image_status": "TO_PRODUCE"
    },
    {
      "scene_id": "M110-C12-S03",
      "chapter": 12,
      "scene": 3,
      "title": "最终选择",
      "asset_id": "M110-BG-047",
      "narration_zh": "玩家选择A至E未来路线。",
      "dialogue_en": [
