}},"checkpoint_required":true,"human_labels":{"A":"申请独立测绘","B":"先封存地下资料与现场"}},"7":{"choice_id":"chapter_7_choice","options":{"A":{"set":{"emergency_priority":"evacuation_first"},"facts":["safety_log:evacuation"],"event_id":"M102_CH07_A"},"B":{"set":{"emergency_priority":"equipment_after_clearance"},"facts":["safety_log:evidence_preserved"],"event_id":"M102_CH07_B"}},"checkpoint_required":true,"human_labels":{"A":"优先完成安全疏散与人证记录","B":"确认无人后保全损坏设备"}},"8":{"choice_id":"chapter_8_choice","options":{"A":{"set":{"media_response":"legal_correction"},"facts":["privacy_policy:strict"],"event_id":"M102_CH08_A"},"B":{"set":{"media_response":"privacy_redacted_release"},"facts":["privacy_policy:redacted_public"],"event_id":"M102_CH08_B"}},"checkpoint_required":true,"human_labels":{"A":"依法核验与澄清","B":"经隐私处理后公开原始片段"}},"9":{"choice_id":"chapter_9_choice","options":{"A":{"set":{"witness_verification":"joint_panel"},"facts":["evidence_corroboration:joint"],"event_id":"M102_CH09_A"},"B":{"set":{"witness_verification":"cross_exam"},"facts":["evidence_corroboration:independent"],"event_id":"M102_CH09_B"}},"checkpoint_required":true,"human_labels":{"A":"建立联合核验小组","B":"分别交叉取证"}},"10":{"choice_id":"chapter_10_choice","options":{"A":{"set":{"property_plan":"public_hearing"},"facts":["hearing_preparation:retain_site"],"event_id":"M102_CH10_A"},"B":{"set":{"property_plan":"relocation_assessment"},"facts":["hearing_preparation:dual_track"],"event_id":"M102_CH10_B"}},"checkpoint_required":true,"human_labels":{"A":"推动公开听证保留原址","B":"同步评估合法迁址"}},"11":{"choice_id":"chapter_11_choice","options":{"A":{"set":{"helper_permissions":"disclosure_with_review"},"facts":["active_assistance:limited_review"],"event_id":"M102_CH11_A"},"B":{"set":{"helper_permissions":"suspended"},"facts":["active_assistance:none"],"event_id":"M102_CH11_B"}},"checkpoint_required":true,"human_labels":{"A":"要求四方披露并复核","B":"暂停四人的协助权限"}},"12":{"choice_id":"chapter_12_choice","options":{"A":{"set":{"ownership_model":"independent"},"facts":["ownership_control:sole"],"event_id":"M102_CH12_A"},"B":{"set":{"ownership_model":"minority_partners"},"facts":["ownership_control:player_majority"],"event_id":"M102_CH12_B"}},"checkpoint_required":true,"human_labels":{"A":"坚持完全独立经营","B":"引入公开透明的少数合伙"}},"13":{"choice_id":"chapter_13_choice","options":{"A":{"set":{"romance_declaration":"open_for_explicit_target"},"facts":["romance_status:pending_target"],"event_id":"M102_CH13_A"},"B":{"set":{"romance_declaration":"deferred"},"facts":["romance_status:not_now"],"event_id":"M102_CH13_B"}},"checkpoint_required":true,"human_labels":{"A":"回应一位角色的情感","B":"暂不回应，保持各自关系"}},"14":{"choice_id":"chapter_14_choice","options":{"A":{"set":{"celebration":"optional_guest"},"facts":["epilogue_tone:guest_pending"],"event_id":"M102_CH14_A"},"B":{"set":{"celebration":"alone"},"facts":["epilogue_tone:independent"],"event_id":"M102_CH14_B"}},"checkpoint_required":true,"human_labels":{"A":"邀请一位角色留下庆祝","B":"独自经营，保持自由"}}},"entries":{"2":{"gate_id":"M102_CH02_ENTRY","from_choice":"chapter_1_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH02_A","text":"桌上按序排着四份已登记的文件，艾米给每一份盖上时间戳。昨夜四个人留下证据后都离开了；你今天可以随时撤销会面许可。卢卡只在店外等艾米确认，才把装着热可可的纸袋交给她。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH02_B","text":"昨夜被请离的四人没有再进店。艾米通过店铺原有维修供应商预约了持证技师，证据由你独立保管。清晨门口出现一个未署名的保温袋，艾米没有擅自拿进来。","present_actor_access":"no assumption of reentry, third-party path"}}},"3":{"gate_id":"M102_CH03_ENTRY","from_choice":"chapter_2_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH03_A","text":"卢卡的零件清单与独立技师的检测编号放在账册里；使用设备不意味着同意收购。加布里埃尔提出把老顾客记忆做成可撤回的口述档案。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH03_B","text":"独立维修商完成首轮诊断，卢卡没有触碰设备。诺兰从公共道路拍摄配电箱外壳照片，先请求店方允许公开专业判断。","present_actor_access":"no assumption of reentry, third-party path"}}},"4":{"gate_id":"M102_CH04_ENTRY","from_choice":"chapter_3_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH04_A","text":"社区会议的记录由艾米逐页编号，十七位居民愿意核对往年租约；塞巴斯蒂安要求保留不同意见，不替居民概括立场。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH04_B","text":"艾米调取到官方登记副本与时间戳，发现其中一份递交申请使用了错误的授权编号。她不下定论，而是请你决定由谁申请正式核查。","present_actor_access":"no assumption of reentry, third-party path"}}},"5":{"gate_id":"M102_CH05_ENTRY","from_choice":"chapter_4_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH05_A","text":"银行已出具款项冻结受理回执，艾米把原始进账记录装进透明封套。卢卡主动说明他的融资方与款项有关联，但不证明他授权转账。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH05_B","text":"经银行确认，款项按正规程序退回原账户，银行仍保留原始流水。塞巴斯蒂安提醒：退回资金不代表可以停止追查伪造签名。","present_actor_access":"no assumption of reentry, third-party path"}}},"6":{"gate_id":"M102_CH06_ENTRY","from_choice":"chapter_5_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH06_A","text":"你授权的联合工作表已写明信息公开、利益冲突披露和撤回权限。四位男人第一次必须把各自提案摆在同一页上。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH06_B","text":"四份材料被分别编号，任何一人都不能接触其他人的未公开文件。艾米负责记录提交日期，避免他们借调查彼此套话。","present_actor_access":"no assumption of reentry, third-party path"}}},"7":{"gate_id":"M102_CH07_ENTRY","from_choice":"chapter_6_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH07_A","text":"独立测绘机构已接受申请，正式进入地下空间前要等待安全许可。诺兰坦言不愿你冒险，却不能以关心代替你作决定。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH07_B","text":"地下入口贴好临时封条并拍照存证，艾米保管两份钥匙清单；隔着玻璃，卢卡看见你没有让任何人取得单独通行权。","present_actor_access":"no assumption of reentry, third-party path"}}},"8":{"gate_id":"M102_CH08_ENTRY","from_choice":"chapter_7_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH08_A","text":"先完成疏散的人证清单和伤情核对；诺兰因处置过急向店员道歉，不把自己写成救援英雄。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH08_B","text":"现场已确认无人滞留，损坏设备由独立工程师拍照封存；一道私人短信提醒你别急着把意外称为袭击。","present_actor_access":"no assumption of reentry, third-party path"}}},"9":{"gate_id":"M102_CH09_ENTRY","from_choice":"chapter_8_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH09_A","text":"法务核验程序启动；塞巴斯蒂安交出原工作通讯记录，拒绝使用威胁记者的方式压下报道。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH09_B","text":"经到场者同意，原片段已模糊处理店员脸部和顾客信息；视频发布后仍有人断章取义，加布里埃尔提出证据说明而非情绪反击。","present_actor_access":"no assumption of reentry, third-party path"}}},"10":{"gate_id":"M102_CH10_ENTRY","from_choice":"chapter_9_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH10_A","text":"联合核验小组成立，所有男性参与人都公开利益关系；艾米担任独立记录员。诺兰提出一条自己无法解释的现场时间线。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH10_B","text":"四份证据交给彼此不隶属的核验人员，会议更慢但避免共享口径。卢卡主动交出与投资人之间的原始邮件。","present_actor_access":"no assumption of reentry, third-party path"}}},"11":{"gate_id":"M102_CH11_ENTRY","from_choice":"chapter_10_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH11_A","text":"听证申请获登记，社区收到正式公众参与告知；你可以发言也可以委托代理。四位男人开始讨论如何保护营业期间的客人。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH11_B","text":"备选迁址估价由独立机构出具，不等于你选择搬迁。加布里埃尔帮阿黛尔太太寻找可移动的旧相册，避免把居民记忆当成商业卖点。","present_actor_access":"no assumption of reentry, third-party path"}}},"12":{"gate_id":"M102_CH12_ENTRY","from_choice":"chapter_11_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH12_A","text":"四方披露表公开后，塞巴斯蒂安承认自己过去对规划项目作过收费咨询；他的自我辩解不能代替审查。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH12_B","text":"你暂停四人接触店内资料，他们只能通过艾米转达正规材料。卢卡第一次体验到无法靠留下来照顾你解决关系问题。","present_actor_access":"no assumption of reentry, third-party path"}}},"13":{"gate_id":"M102_CH13_ENTRY","from_choice":"chapter_12_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH13_A","text":"你决定独立经营，艾米送来没有投资附加条款的新排班表。卢卡听见后只说一声好，没有再拿资金表达喜欢。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH13_B","text":"公开合伙草案加入回购、知情、禁止关联交易条款。塞巴斯蒂安建议聘请与他无利益关系的律师逐条核对。","present_actor_access":"no assumption of reentry, third-party path"}}},"14":{"gate_id":"M102_CH14_ENTRY","from_choice":"chapter_13_choice","mode":"exclusive_select","variants":{"A":{"scene_id":"M102_CH14_A","text":"你已明确回应一人的感情，其他人不会自动知道具体内容。收到回应的人选择先确认约会意愿，而不是宣布所有权；艾米把情书放回原信封。","present_actor_access":"only consented actors, others remote"},"B":{"scene_id":"M102_CH14_B","text":"你暂不回应任何人的告白。四人都还拥有各自的职业和生活，咖啡店照常营业。加布里埃尔把未公开的周年照片交由你自己决定何时展示。","present_actor_access":"no assumption of reentry, third-party path"}}}}}